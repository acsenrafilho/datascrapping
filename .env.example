# Copy to .env and fill in when using authenticated scrapers (e.g. BNI).
# BNI Connect login field is labeled Username (email or username both work if valid).
BNI_EMAIL=
BNI_PASSWORD=

# Google Places (New) — prospection key for places.search (not Lead Control SaaS Maps).
GOOGLE_PLACES_API_KEY=

# Optional Gemini for places.website fill-gaps (requires: poetry install -E llm)
GEMINI_API_KEY=

# Optional defaults for polite scraping (blogs)
SCRAPE_DELAY_MIN=1.0
SCRAPE_DELAY_MAX=3.0
OUTPUT_DIR=output
